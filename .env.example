# Salin file ini jadi .env lalu isi kredensial OAuth.
# .env TIDAK ikut di-commit (lihat .gitignore).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/ArrStudioWeb/index.php?page=auth_google_callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost/ArrStudioWeb/index.php?page=auth_discord_callback

# YT → MP3: path binary (kosong = cari di PATH)
YTDLP_BIN=
FFMPEG_BIN=
